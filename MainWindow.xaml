<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Launcher.Converters"
        xmlns:models="clr-namespace:Launcher.Models"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Launcher"
        Icon="Assets/Icons/apps.png"
        Width="1680"
        Height="900"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Window}"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="1"
        Loaded="OnLoaded"
        AllowDrop="True"
        Drop="OnWindowDrop"
        GiveFeedback="OnGiveFeedback"
        PreviewDragOver="OnPreviewDragOver">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:ActiveTabConverter x:Key="ActiveTabConverter"/>
        <conv:FavoriteHeaderConverter x:Key="FavoriteHeaderConverter"/>
        <conv:CategoryToHeaderConverter x:Key="CategoryToHeaderConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1E1E29"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#292936"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" CornerRadius="18">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource ThemeBrushConverter}" ConverterParameter="TabBackground">
                                    <Binding Path="DataContext.IsLightTheme" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </Border.Background>
                            <TextElement.Foreground>
                                <MultiBinding Converter="{StaticResource ThemeBrushConverter}" ConverterParameter="TabForeground">
                                    <Binding Path="DataContext.IsLightTheme" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </TextElement.Foreground>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartupToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Background" Value="#111118"/>
            <Setter Property="BorderBrush" Value="#252536"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="18">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#4B5563" Margin="0,0,7,0"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#172554"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="Dot" Property="Fill" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherCardStyle" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="196"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#12121A"/>
            <Setter Property="BorderBrush" Value="#242433"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.18" RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                ClipToBounds="True">
                            <Grid>
                                <ContentPresenter/>
                                <Border x:Name="HoverVeil" Background="#7A000000" Opacity="0"/>
                                <Border x:Name="HoverBorder"
                                        BorderBrush="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=CardHoverBorder}"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Margin="0"
                                        Opacity="0"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="CornerTopLeft" Width="10" Height="2" Background="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=CardCornerAccent}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
                                <Border x:Name="CornerTopLeftV" Width="2" Height="10" Background="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=CardCornerAccent}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
                                <Border x:Name="CornerBottomRight" Width="10" Height="2" Background="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=CardCornerAccent}" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"/>
                                <Border x:Name="CornerBottomRightV" Width="2" Height="10" Background="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=CardCornerAccent}" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"/>
                            </Grid>
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,150,196" RadiusX="12" RadiusY="12"/>
                            </Border.Clip>
                        </Border>
                        <ControlTemplate.Resources>
                            <Duration x:Key="HoverDuration">0:0:0.3</Duration>
                        </ControlTemplate.Resources>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="-4" Duration="{StaticResource HoverDuration}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverVeil" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerTopLeft" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerTopLeft" Storyboard.TargetProperty="Width" To="16" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerTopLeftV" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerTopLeftV" Storyboard.TargetProperty="Height" To="16" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerBottomRight" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerBottomRight" Storyboard.TargetProperty="Width" To="16" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerBottomRightV" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerBottomRightV" Storyboard.TargetProperty="Height" To="16" Duration="{StaticResource HoverDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="{StaticResource HoverDuration}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverVeil" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerTopLeft" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerTopLeft" Storyboard.TargetProperty="Width" To="10" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerTopLeftV" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerTopLeftV" Storyboard.TargetProperty="Height" To="10" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerBottomRight" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerBottomRight" Storyboard.TargetProperty="Width" To="10" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerBottomRightV" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="CornerBottomRightV" Storyboard.TargetProperty="Height" To="10" Duration="{StaticResource HoverDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-4"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="HoverBorder" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerTopLeft" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerTopLeft" Property="Width" Value="16"/>
                                <Setter TargetName="CornerTopLeftV" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerTopLeftV" Property="Height" Value="16"/>
                                <Setter TargetName="CornerBottomRight" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerBottomRight" Property="Width" Value="16"/>
                                <Setter TargetName="CornerBottomRightV" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerBottomRightV" Property="Height" Value="16"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16"
            Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Root}"
            BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=RootBorder}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="86"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.Background>
                <Binding Path="IsLightTheme" Converter="{StaticResource ThemeBrushConverter}" ConverterParameter="Root"/>
            </Grid.Background>

            <Border Grid.Row="0" Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Header}" BorderThickness="0" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="44" Padding="0,4" CornerRadius="22" Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=HeaderPill}" BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=HeaderPillBorder}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource TabButtonStyle}" Content="YÊU THÍCH"
                                          IsChecked="{Binding ActiveTab, Converter={StaticResource ActiveTabConverter}, ConverterParameter=YÊU THÍCH}"/>
                            <ToggleButton Style="{StaticResource TabButtonStyle}" Content="KHO GAME"
                                          IsChecked="{Binding ActiveTab, Converter={StaticResource ActiveTabConverter}, ConverterParameter=KHO GAME}"/>
                            <ToggleButton Style="{StaticResource TabButtonStyle}" Content="ỨNG DỤNG"
                                          IsChecked="{Binding ActiveTab, Converter={StaticResource ActiveTabConverter}, ConverterParameter=ỨNG DỤNG}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButtonStyle}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="Cài đặt">
                            <materialDesign:PackIcon Kind="Cog" Width="22" Height="22"/>
                        </Button>
                        <Button Style="{StaticResource WindowButtonStyle}" Content="-" Click="OnMinimizeClick" ToolTip="Thu nhỏ"/>
                        <Button Style="{StaticResource WindowButtonStyle}" Content="□" Click="OnMaximizeClick" ToolTip="Phóng to"/>
                        <Button Style="{StaticResource CloseButtonStyle}" Content="×" Click="OnCloseClick" ToolTip="Đóng"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,20,18,18"
                  Visibility="{Binding IsLauncherTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Search}" BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchBorder}" BorderThickness="1" CornerRadius="10"/>
                <TextBlock Text="⌕" Margin="18,0,0,0" Foreground="#7F8AA3" FontSize="25" VerticalAlignment="Center"/>
                <TextBox Margin="56,0,14,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="18"
                         FontWeight="SemiBold"
                         CaretBrush="White"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="Tìm kiếm ứng dụng..."
                           Margin="56,0,0,0"
                           Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Placeholder}"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Border Grid.Row="2" Margin="18,0,18,20" CornerRadius="12" Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=ListPanel}" BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=ListBorder}" BorderThickness="1"
                    Visibility="{Binding IsLauncherTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" PanningMode="VerticalOnly">
                    <ItemsControl x:Name="LaunchersList" ItemsSource="{Binding FilteredLaunchers}" 
                                  AllowDrop="True" Drop="OnLauncherDrop"
                                  KeyboardNavigation.DirectionalNavigation="Continue"
                                  KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="162" ItemHeight="216" KeyboardNavigation.DirectionalNavigation="Continue"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LauncherItem}">
                                <DataTemplate.Resources>
                                    <Duration x:Key="CardHoverDuration">0:0:0.3</Duration>
                                </DataTemplate.Resources>
                                    <Button Style="{StaticResource LauncherCardStyle}"
                                            Background="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Card}"
                                            BorderBrush="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=CardBorder}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Click="OnLauncherClick"
                                            PreviewMouseLeftButtonDown="OnLauncherPreviewMouseLeftButtonDown"
                                            PreviewMouseMove="OnLauncherPreviewMouseMove"
                                            PreviewMouseRightButtonDown="OnLauncherPreviewMouseRightButtonDown">
                                        <Button.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="LauncherIcon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.08" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="LauncherIcon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.08" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="IconDimmer" Storyboard.TargetProperty="Opacity" To="0.7" Duration="{StaticResource CardHoverDuration}"/>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource CardHoverDuration}"/>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.06" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.06" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="LauncherIcon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="LauncherIcon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="IconDimmer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CardHoverDuration}"/>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CardHoverDuration}"/>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0.86" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0.86" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="GotKeyboardFocus">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="LauncherIcon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.08" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="LauncherIcon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.08" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="IconDimmer" Storyboard.TargetProperty="Opacity" To="0.7" Duration="{StaticResource CardHoverDuration}"/>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource CardHoverDuration}"/>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.06" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.06" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="LostKeyboardFocus">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="LauncherIcon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="LauncherIcon" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="IconDimmer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CardHoverDuration}"/>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CardHoverDuration}"/>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0.86" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0.86" Duration="{StaticResource CardHoverDuration}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Button.Triggers>
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Thêm launcher" Command="{Binding PlacementTarget.Tag.AddLauncherCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Thêm folder" Command="{Binding PlacementTarget.Tag.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Thêm Calculator" Command="{Binding PlacementTarget.Tag.AddCalculatorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Thêm Clock" Command="{Binding PlacementTarget.Tag.AddClockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Sửa launcher" Command="{Binding PlacementTarget.Tag.EditLauncherCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Sửa icon" Command="{Binding PlacementTarget.Tag.EditIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{Binding PlacementTarget.DataContext.Category, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource CategoryToHeaderConverter}}"
                                                          Command="{Binding PlacementTarget.Tag.ToggleCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Open file location" Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{Binding PlacementTarget.DataContext.IsFavorite, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource FavoriteHeaderConverter}}"
                                                          Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Xóa launcher" Command="{Binding PlacementTarget.Tag.RemoveLauncherCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="150"/>
                                                <RowDefinition Height="46"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="IconSurface" Grid.Row="0" Background="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=CardIcon}" CornerRadius="11,11,0,0" Margin="1,1,1,0">
                                                <Grid ClipToBounds="True">
                                                    <Image x:Name="LauncherIcon"
                                                           Source="{Binding IconPath, IsAsync=True}"
                                                           Width="98"
                                                           Height="98"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5">
                                                        <Image.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </Image.RenderTransform>
                                                    </Image>
                                                    <Border x:Name="IconDimmer"
                                                            Background="#000000"
                                                            Opacity="0"/>
                                                    <Grid x:Name="PlayGlyph"
                                                          Width="48"
                                                          Height="48"
                                                          Opacity="0"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform ScaleX="0.86" ScaleY="0.86"/>
                                                        </Grid.RenderTransform>
                                                        <Ellipse Fill="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=PlayButton}"/>
                                                        <materialDesign:PackIcon Kind="Play"
                                                                                 Width="24"
                                                                                 Height="24"
                                                                                 Foreground="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=PlayIcon}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="3,0,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Background="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=CardFooter}" CornerRadius="0,0,11,11" Margin="1,0,1,1">
                                                <TextBlock x:Name="LauncherName"
                                                           Text="{Binding Name}"
                                                           Foreground="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=CardName}"
                                                           FontFamily="Segoe UI"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="36"
                                                           Margin="8,0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1"
                    Grid.RowSpan="2"
                    Margin="18,20,18,20"
                    CornerRadius="12"
                    Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=ListPanel}"
                    BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=ListBorder}"
                    BorderThickness="1"
                    Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22" PanningMode="VerticalOnly">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource WindowButtonStyle}"
                                    Width="44"
                                    Height="38"
                                    Margin="0,0,10,0"
                                    Command="{Binding CloseSettingsCommand}"
                                    ToolTip="Quay lại">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="22" Height="22"/>
                            </Button>
                            <TextBlock Grid.Column="1"
                                       Text="Cài đặt"
                                       Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}"
                                       FontSize="24"
                                       FontWeight="Black"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Tuỳ chỉnh cách launcher mở, ẩn và hoạt động cùng Windows."
                                   Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Placeholder}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,24"/>

                        <Border Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Search}"
                                BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="Scan ứng dụng và game"
                                                   Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}"
                                                   FontSize="16"
                                                   FontWeight="Black"/>
                                        <TextBlock Text="{Binding ScanStatus}"
                                                   Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Placeholder}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource WindowButtonStyle}"
                                                Width="104"
                                                Command="{Binding ScanLaunchersCommand}"
                                                ToolTip="Quét ứng dụng và game trong máy">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="SCAN" FontSize="11" FontWeight="Black"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource WindowButtonStyle}"
                                                Width="92"
                                                Margin="8,0,0,0"
                                                Command="{Binding CancelScanCommand}"
                                                ToolTip="Dừng scan">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Stop" Width="18" Height="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="DỪNG" FontSize="11" FontWeight="Black"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,16,0,12">
                                    <CheckBox Content="Start Menu/Desktop" IsChecked="{Binding ScanStartMenuAndDesktop}" Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}" FontWeight="SemiBold" Margin="0,0,18,8"/>
                                    <CheckBox Content="Recent software" IsChecked="{Binding ScanRecentSoftware}" Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}" FontWeight="SemiBold" Margin="0,0,18,8"/>
                                    <CheckBox Content="Registry" IsChecked="{Binding ScanRegistry}" Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}" FontWeight="SemiBold" Margin="0,0,18,8"/>
                                    <CheckBox Content="User profile" IsChecked="{Binding ScanUserProfile}" Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}" FontWeight="SemiBold" Margin="0,0,18,8"/>
                                    <CheckBox Content="Ổ đĩa game" IsChecked="{Binding ScanDrives}" Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}" FontWeight="SemiBold" Margin="0,0,18,8"/>
                                </WrapPanel>

                                <ProgressBar Height="6"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Foreground="#3B82F6"
                                             Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Height="36"
                                             Text="{Binding ScanCustomPath, UpdateSourceTrigger=PropertyChanged}"
                                             Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}"
                                             Background="Transparent"
                                             BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchBorder}"
                                             FontSize="13"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Đường dẫn tuỳ chọn để scan"/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource WindowButtonStyle}"
                                            Width="92"
                                            Margin="8,0,0,0"
                                            Command="{Binding BrowseScanPathCommand}"
                                            ToolTip="Chọn thư mục">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="CHỌN" FontSize="11" FontWeight="Black"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Style="{StaticResource WindowButtonStyle}" Width="112" Command="{Binding SelectAllScanResultsCommand}" ToolTip="Chọn tất cả kết quả">
                                        <TextBlock Text="CHỌN HẾT" FontSize="11" FontWeight="Black"/>
                                    </Button>
                                    <Button Style="{StaticResource WindowButtonStyle}" Width="96" Margin="8,0,0,0" Command="{Binding ClearScanResultsSelectionCommand}" ToolTip="Bỏ chọn">
                                        <TextBlock Text="BỎ CHỌN" FontSize="11" FontWeight="Black"/>
                                    </Button>
                                    <Button Style="{StaticResource WindowButtonStyle}" Width="112" Margin="8,0,0,0" Command="{Binding AddSelectedScanResultsCommand}" ToolTip="Thêm các mục đã tick">
                                        <TextBlock Text="THÊM" FontSize="11" FontWeight="Black"/>
                                    </Button>
                                </StackPanel>

                                <Border MaxHeight="260"
                                        BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ScanResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchBorder}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="0,8">
                                                        <CheckBox IsChecked="{Binding IsSelected}">
                                                            <Grid Margin="8,0,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="38"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Width="32"
                                                                        Height="32"
                                                                        CornerRadius="7"
                                                                        Background="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=CardIcon}">
                                                                    <Image Source="{Binding IconPath, IsAsync=True}"
                                                                           Width="24"
                                                                           Height="24"
                                                                           Stretch="Uniform"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Border>
                                                                <Grid Grid.Column="1">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                                               Foreground="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}"
                                                                               FontWeight="Black"
                                                                               FontSize="13"/>
                                                                    <TextBlock Grid.Row="1"
                                                                               Foreground="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Placeholder}"
                                                                               FontSize="11"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                                                        <Run Text=" · "/>
                                                                        <Run Text="{Binding Source, Mode=OneWay}"/>
                                                                        <Run Text=" · "/>
                                                                        <Run Text="{Binding ExecutablePath, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Grid>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Search}"
                                BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Cập nhật launcher"
                                               Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}"
                                               FontSize="16"
                                               FontWeight="Black"/>
                                    <TextBlock Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Placeholder}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0">
                                        <Run Text="Phiên bản hiện tại "/>
                                        <Run Text="{Binding CurrentVersion, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding UpdateStatus}"
                                               Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Placeholder}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource WindowButtonStyle}"
                                            Width="112"
                                            Command="{Binding CheckForUpdateCommand}"
                                            ToolTip="Kiểm tra bản mới">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="KIỂM TRA" FontSize="11" FontWeight="Black"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource WindowButtonStyle}"
                                            Width="112"
                                            Margin="8,0,0,0"
                                            Command="{Binding UpdateLauncherCommand}"
                                            ToolTip="Tải và cài bản mới nhất">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Download" Width="18" Height="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="UPDATE" FontSize="11" FontWeight="Black"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Search}"
                                BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Giao diện sáng/tối"
                                               Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}"
                                               FontSize="16"
                                               FontWeight="Black"/>
                                    <TextBlock Text="Bật giao diện sáng cho launcher."
                                               Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Placeholder}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource StartupToggleStyle}"
                                              Width="132"
                                              IsChecked="{Binding IsLightTheme}"
                                              Content="LIGHT"/>
                            </Grid>
                        </Border>

                        <Border Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Search}"
                                BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Mở fullscreen khi khởi động"
                                               Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}"
                                               FontSize="16"
                                               FontWeight="Black"/>
                                    <TextBlock Text="Launcher sẽ tự phóng to khi mở app."
                                               Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Placeholder}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource StartupToggleStyle}"
                                              Width="132"
                                              IsChecked="{Binding OpenFullscreenOnStartup}"
                                              Content="FULLSCREEN"/>
                            </Grid>
                        </Border>

                        <Border Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Search}"
                                BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Minimize sau khi mở ứng dụng"
                                               Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}"
                                               FontSize="16"
                                               FontWeight="Black"/>
                                    <TextBlock Text="Sau khi bấm launcher, cửa sổ launcher sẽ tự thu nhỏ."
                                               Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Placeholder}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource StartupToggleStyle}"
                                              Width="132"
                                              IsChecked="{Binding MinimizeAfterLaunch}"
                                              Content="MINIMIZE"/>
                            </Grid>
                        </Border>

                        <Border Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Search}"
                                BorderBrush="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Start with Windows"
                                               Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=SearchText}"
                                               FontSize="16"
                                               FontWeight="Black"/>
                                    <TextBlock Text="Tự mở launcher khi đăng nhập Windows."
                                               Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Placeholder}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource StartupToggleStyle}"
                                              Width="132"
                                              IsChecked="{Binding StartWithWindows}"
                                              Content="STARTUP"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Button Grid.Row="2" Width="52" Height="52" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,34,34"
                    Command="{Binding AddLauncherCommand}"
                    Background="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=Fab}"
                    Foreground="{Binding IsLightTheme, Converter={StaticResource ThemeBrushConverter}, ConverterParameter=FabIcon}"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Visibility="{Binding IsLauncherTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Thêm launcher" Command="{Binding PlacementTarget.DataContext.AddLauncherCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Thêm folder" Command="{Binding PlacementTarget.DataContext.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Thêm Calculator" Command="{Binding PlacementTarget.DataContext.AddCalculatorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Thêm Clock" Command="{Binding PlacementTarget.DataContext.AddClockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <materialDesign:PackIcon Kind="Plus" Width="28" Height="28"/>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Grid x:Name="FullscreenRippleOverlay"
                  Grid.RowSpan="3"
                  Panel.ZIndex="900"
                  Background="#22000000"
                  Opacity="0"
                  Visibility="Collapsed"
                  IsHitTestVisible="True">
                <Grid Width="180"
                      Height="180"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Ellipse x:Name="FullscreenRipple"
                             Width="30"
                             Height="30"
                             Stroke="#3B82F6"
                             StrokeThickness="3"
                             Fill="#223B82F6"
                             Opacity="0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="0.2" ScaleY="0.2"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="FullscreenRippleCore"
                             Width="14"
                             Height="14"
                             Fill="#3B82F6"
                             Opacity="0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Grid>

            <Grid Grid.RowSpan="3"
                  Panel.ZIndex="950"
                  Background="#99000000"
                  Visibility="Collapsed">
                <Border Width="220"
                        Height="128"
                        CornerRadius="14"
                        Background="#F8FFFFFF"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="120"
                                     Height="8"
                                     IsIndeterminate="True"
                                     Foreground="#3B82F6"
                                     Margin="0,0,0,18"/>
                        <TextBlock Text="Đang scan..."
                                   Foreground="#111827"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Canvas x:Name="DragCanvas" Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="1000">
                <Border x:Name="DragShadow"
                        Width="120" Height="160"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="10"
                        Opacity="0.8"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2"
                                Background="#1A1A26"
                                CornerRadius="10"/>
                        <Border Grid.Row="0" Background="#12121A" CornerRadius="10,10,0,0" Margin="1.5,1.5,1.5,0">
                            <Grid ClipToBounds="True">
                                <Image Source="{Binding IconPath, IsAsync=True}"
                                       Width="72"
                                       Height="72"
                                       Stretch="Uniform"
                                       Opacity="0.9"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <BlurEffect Radius="4" KernelType="Gaussian"/>
                                    </Image.Effect>
                                </Image>
                                <Border Background="#000000" Opacity="0.7"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="#0D0D13" CornerRadius="0,0,10,10" Margin="1.5,0,1.5,1.5">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="6,0"/>
                        </Border>
                        <Border Grid.RowSpan="2"
                                BorderBrush="#F2FFFFFF"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Canvas>

        </Grid>
    </Border>
</Window>
