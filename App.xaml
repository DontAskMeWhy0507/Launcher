<Application x:Class="Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Converters"
             Startup="OnStartup">
    <Application.Resources>
        <conv:ThemeBrushConverter x:Key="ThemeBrushConverter"/>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A0A0F"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#0F0F16"/>
        <SolidColorBrush x:Key="CardBrush" Color="#12121A"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1F1F2A"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8D8D99"/>
        <SolidColorBrush x:Key="BodyTextBrush" Color="#D1D5DB"/>
    </Application.Resources>
</Application>
